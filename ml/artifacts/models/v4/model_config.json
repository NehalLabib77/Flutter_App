{
  "selected_model_version": "v4_word_tfidf_strict_url_image",
  "source_preprocessor": "tfidf_strict_v4",
  "filter_policy": {
    "rule": "strict_AND",
    "require_valid_course_url": true,
    "require_valid_image_url": true,
    "invalidate_tokens": [
