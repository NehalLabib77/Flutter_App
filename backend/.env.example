# Copy to .env and adjust before starting the backend.
#
# NOTE: DATABASE_URL is only used by the Development config. On Render
# (production) the value is *required* and is read directly from the
# Render web service's environment — copy the "Internal Database URL"
# from your PostgreSQL service's Info tab into the web service's
# DATABASE_URL env var. Never commit a real production URL here.

FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Local dev default. Production ignores this and requires DATABASE_URL.
DATABASE_URL=sqlite:///educompass.db

# Path to the TF-IDF joblib bundle (relative paths are resolved against backend/).
MODEL_DIR=../ml/artifacts/models/v2
LEARNING_PATHS_FILE=./data/learning_paths.json

CORS_ORIGINS=http://localhost,http://localhost:3000,http://10.0.2.2

LOG_LEVEL=INFO
# Auto-create tables on app start (development only).
# On Render, leave this unset / false and run `flask init-db` once
# from the Render shell instead.
AUTO_CREATE_DB=true

# Payment gateway (SSLCOMMERZ)
PAYMENT_MODE=sandbox
SSLC_STORE_ID= educo6a73136c559c5
SSLC_STORE_PASSWORD= educo6a73136c559c5@ssl
PUBLIC_BASE_URL= https://educompass-api.onrender.com/
# When true, the backend serves a mock payment session instead of
# calling SSLCOMMERZ. Live SSLCOMMERZ flow expects USE_MOCK_PAYMENT=false.
USE_MOCK_PAYMENT=false
APP_RETURN_URI=educompass://payment/return
# Optional override for gateway HTTP timeout (seconds)
PAYMENT_HTTP_TIMEOUT_SECONDS=12
