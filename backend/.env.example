# Copy to .env and adjust before starting the backend.

FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

DATABASE_URL=sqlite:///educompass.db
MODEL_DIR=../models
LEARNING_PATHS_FILE=./data/learning_paths.json

CORS_ORIGINS=http://localhost,http://localhost:3000,http://10.0.2.2

# Billing — leave BILLING_PROVIDER=mock for development.
BILLING_PROVIDER=mock
BILLING_OTP_TTL_SECONDS=300
BILLING_OTP_RESEND_COOLDOWN_SECONDS=60
BILLING_OTP_MAX_ATTEMPTS=5

# BdApps — only required if BILLING_PROVIDER=bdapps
# BDAPPS_APPLICATION_ID=
# BDAPPS_PASSWORD=
# BDAPPS_APPLICATION_HASH=
# BDAPPS_OTP_REQUEST_URL=
# BDAPPS_OTP_VERIFY_URL=
# BDAPPS_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO
AUTO_CREATE_DB=true
