# ---- ML artifacts (large joblib bundles, model metadata) ----
# Note: the lightweight v4 bundle (courses.parquet + tfidf_matrix.npz +
# tfidf_vectorizer.joblib + model_config.json + model_metadata.json) is
# INTENTIONALLY tracked so Render can load it directly from the repo.
# It is regenerated by ml/training/train_v4.py and stays under 100 MB
# per file.
ml/artifacts/models/*.joblib
ml/artifacts/models/*.pkl
ml/artifacts/models/*.npz
# Re-include the lightweight v4 deployment bundle:
!ml/artifacts/models/v4/
!ml/artifacts/models/v4/courses.parquet
!ml/artifacts/models/v4/tfidf_vectorizer.joblib
!ml/artifacts/models/v4/tfidf_matrix.npz
!ml/artifacts/models/v4/model_config.json
!ml/artifacts/models/v4/model_metadata.json
# Explicitly exclude the heavy v2 / v3 artefacts and similar generated files:
ml/artifacts/models/v2/*.joblib
ml/artifacts/models/v2/*.pkl
ml/artifacts/models/v3/*.joblib
ml/artifacts/models/v3/*.pkl
ml/artifacts/models/v3/*.npz
ml/artifacts/models/**/char_matrix.joblib
ml/artifacts/models/**/char_vectorizer.joblib
ml/artifacts/models/**/word_matrix.joblib
ml/artifacts/models/**/field_vectorizers.joblib
ml/artifacts/models/**/similarity.pkl
ml/artifacts/models/**/*.bin
ml/artifacts/models/**/*.h5
ml/artifacts/models/**/*.pt
ml/artifacts/models/**/*.pth

# Local backup of the previous v4 deployment bundle, kept on disk for
# archaeology but never pushed. Regenerate with
# ``python ml/training/train_v4_15k.py`` if you ever need it back.
ml/artifacts/models/v4_backup_before_15k/
ml/artifacts/models/v4_backup_before_15k/**

# ---- Large / regenerable datasets (keep raw small samples, ignore huge ones) ----
data/raw/*.csv
data/raw/*.json
data/raw/*.xls
data/raw/*.xlsx
data/raw/Coursera_catalog.csv
data/raw/edx_*.json
data/raw/coursera_1000_Courses/
data/processed/*.json
data/processed/*.csv
data/processed/*.parquet

# ---- Jupyter ----
.ipynb_checkpoints/
ml/notebooks/.ipynb_checkpoints/

